# Copy this file to .env in the project root. Never commit .env.
# Install/start a real MySQL 8 server on Windows; Docker is NOT required.
DB_URL=jdbc:mysql://localhost:3306/leave_management?useSSL=false&allowPublicKeyRetrieval=true
DB_USER=leave_app
DB_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD

# Initial admin: on first startup creates an ADMIN account if missing.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=CHANGE_TO_AT_LEAST_12_CHARACTERS

# Enables admin management. Creates or promotes this address to SUPER_ADMIN.
# If the address is already ADMIN, its existing password is preserved.
SUPER_ADMIN_EMAIL=superadmin@example.test
SUPER_ADMIN_PASSWORD=CHANGE_TO_A_DIFFERENT_12_CHAR_PASSWORD

FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
UPLOAD_DIRECTORY=../private-uploads

# Free real-email provider: Brevo (up to 300 email sends/day, subject to policy).
# Keep disabled until you have verified a sender and obtained an SMTP login + key.
# Full guide: docs/EMAIL_SETUP.md. Do not commit your real .env or share the SMTP key.
MAIL_ENABLED=false
MAIL_FROM=your-verified-sender@example.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

